ACTIVE_QUIZZES = {}


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_name = update.effective_user.first_name
    welcome_message = (
        f"Salut {user_name} ! 🚀 Bienvenue sur ton bot de préparation INFAS (Concours Directs).\n\n"
        "Je suis configuré pour t'entraîner sur les SVT (physiologie nerveuse, potentiels, etc.).\n\n"
        "📜 **Commandes disponibles :**\n"
        "• /quiz - Lancer une session de quiz dans le groupe\n"
        "• /random - Poser une question aléatoire instantanée\n"
        "• /stats - Voir tes scores\n"
        "• /help - Afficher l'aide"
    )
    await update.message.reply_text(welcome_message)


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    help_text = (
        "💡 **Guide d'utilisation du Bot INFAS :**\n\n"
        "1. Tape `/quiz` dans un groupe pour lancer une série de questions interactives.\n"
        "2. Clique sur les boutons de réponse.\n"
        "3. À la fin du quiz, un classement (podium) des meilleurs participants sera affiché automatiquement !\n"
        "4. Tape `/random` pour une question rapide en solo ou en groupe."
    )
    await update.message.reply_text(help_text)


async def random_question(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = random.choice(QUESTIONS)
    keyboard = [
        [InlineKeyboardButton(opt, callback_data=f"rand_{q['options'].index(opt)}")]
        for opt in q["options"]
    ]
    context.user_data["current_rand"] = q["correct"]
    context.user_data["current_expl"] = q["explication"]

    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text(
        f"🎯 **Question Aléatoire :**\n\n{q['question']}", reply_markup=reply_markup
    )


async def handle_random_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    data = query.data
    if data.startswith("rand_"):
        selected_index = int(data.split("_")[1])
        correct_index = context.user_data.get("current_rand")
        explication = context.user_data.get("current_expl", "")

        if selected_index == correct_index:
            await query.edit_message_text(
                text=f"✅ **Bonne réponse !** 🎉\n\n{explication}"
            )
        else:
            await query.edit_message_text(
                text=f"❌ **Mauvaise réponse.**\n\n{explication}"
            )


async def start_quiz(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id

    if chat_id in ACTIVE_QUIZZES and ACTIVE_QUIZZES[chat_id]["in_progress"]:
        await update.message.reply_text(
            "⚠️ Un quiz est déjà en cours dans ce groupe !"
        )
        return

    ACTIVE_QUIZZES[chat_id] = {
        "in_progress": True,
        "current_question": 0,
        "questions": random.sample(
            QUESTIONS, min(3, len(QUESTIONS))
        ),  
        "scores": {},
    }

    await update.message.reply_text(
        "🏁 **Début du Quiz INFAS !** Préparez-vous, les questions vont s'enchaîner."
    )
    await send_quiz_question(chat_id, context)


async def send_quiz_question(chat_id, context):
    quiz_data = ACTIVE_QUIZZES.get(chat_id)
    if not quiz_data or not quiz_data["in_progress"]:
        return

    idx = quiz_data["current_question"]
    if idx >= len(quiz_data["questions"]):
        await end_quiz(chat_id, context)
        return

    q = quiz_data["questions"][idx]
    keyboard = [
        [
            InlineKeyboardButton(
                opt, callback_data=f"quiz_{idx}_{q['options'].index(opt)}"
            )
        ]
        for opt in q["options"]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)

    await context.bot.send_message(
        chat_id=chat_id,
        text=f"❓ **Question {idx + 1}/{len(quiz_data['questions'])}**\n\n{q['question']}",
        reply_markup=reply_markup,
    )


async def handle_quiz_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    data = query.data
    if data.startswith("quiz_"):
        parts = data.split("_")
        q_idx = int(parts[1])
        selected_index = int(parts[2])
        chat_id = query.message.chat_id
        user = query.from_user
        user_id = user.id
        user_name = user.first_name

        quiz_data = ACTIVE_QUIZZES.get(chat_id)
        if not quiz_data or not quiz_data["in_progress"]:
            await query.edit_message_text(text="Ce quiz est déjà terminé.")
            return

        if q_idx != quiz_data["current_question"]:
            await query.answer("Cette question est déjà passée !", show_alert=True)
            return

        q = quiz_data["questions"][q_idx]
        is_correct = selected_index == q["correct"]

        if user_id not in quiz_data["scores"]:
            quiz_data["scores"][user_id] = {"name": user_name, "points": 0}

        result_text = f"👤 {user_name} a répondu.\n"
        if is_correct:
            quiz_data["scores"][user_id]["points"] += 1
            result_text += "✅ Bonne réponse (+1 point) !"
        else:
            result_text += "❌ Mauvaise réponse."

        result_text += f"\n\n_Explication :_ {q['explication']}"

        try:
            await query.edit_message_text(text=result_text)
        except Exception:
            pass

        quiz_data["current_question"] += 1
        await send_quiz_question(chat_id, context)


async def end_quiz(chat_id, context):
    quiz_data = ACTIVE_QUIZZES.get(chat_id)
    if not quiz_data:
        return

    quiz_data["in_progress"] = False
    scores = quiz_data["scores"]

    podium_text = "🏆 **FIN DU QUIZ - CLASSEMENT DU GROUPE** 🏆\n\n"

    if not scores:
        podium_text += "Aucun participant n'a marqué de points."
    else:
        sorted_scores = sorted(
            scores.values(), key=lambda x: x["points"], reverse=True
        )

        medals = ["🥇", "🥈", "🥉"]
        for i, user_info in enumerate(sorted_scores):
            medal = medals[i] if i < 3 else "🔸"
            podium_text += (
                f"{medal} **{user_info['name']}** : {user_info['points']} point(s)\n"
            )
        
        # Message personnalisé pour le 1er
        first_place_name = sorted_scores[0]["name"]
        podium_text += f"\n🏆 Félicitations aux gagnants!\n👏🏾 Bravo {first_place_name} continue comme ça !"

    await context.bot.send_message(chat_id=chat_id, text=podium_text)
    del ACTIVE_QUIZZES[chat_id]


async def stats_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Fonctionnalité de statistiques en cours de développement !")


